# Leave blank until PostgreSQL credentials are ready; SQLite fallback is used locally.
# After creating the aicte_oneview database, uncomment and set your actual password.
# URL-encode special characters in the password if needed.
DATABASE_URL=

CORS_ORIGINS=http://localhost:4200
APP_ENV=development

# Use a unique random value; production startup rejects the placeholder/short secrets.
JWT_SECRET=CHANGE_THIS_SECRET_BEFORE_PRODUCTION
ACCESS_TOKEN_MINUTES=30

# First-run admin account is created only if this username does not already exist.
BOOTSTRAP_ADMIN_USERNAME=admin
# Set a strong unique value before first backend startup to create the admin account.
BOOTSTRAP_ADMIN_PASSWORD=
